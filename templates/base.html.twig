<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>{% block title %}Youngbrighthing{% endblock %} - Youngbrighthing</title>

		{% set meta_desc = block('meta_description') is defined ? block('meta_description') : 'Youngbrighthing — mode unisexe fait main en France. Capsules limitées, pièces uniques, style urbain brut. Découvrez nos collections.' %}
		<meta name="description" content="{{ meta_desc }}">
		<meta name="robots" content="{% block robots %}index, follow{% endblock %}">

		{% set page_title = block('title') ~ ' - Youngbrighthing' %}
		{% set og_image = block('og_image') is defined ? block('og_image') : absolute_url(asset('images/LOGO_ybt-01_72c34f78-1ef2-4c5c-a378-735dffc185cb.png')) %}
		<meta property="og:type" content="{% block og_type %}website{% endblock %}">
		<meta property="og:site_name" content="Youngbrighthing">
		<meta property="og:locale" content="fr_FR">
		<meta property="og:title" content="{{ page_title }}">
		<meta property="og:description" content="{{ meta_desc }}">
		<meta property="og:url" content="{{ app.request.uri }}">
		<meta property="og:image" content="{{ og_image }}">
		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:title" content="{{ page_title }}">
		<meta name="twitter:description" content="{{ meta_desc }}">
		<meta name="twitter:image" content="{{ og_image }}">

		<link rel="canonical" href="{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}">
		<link rel="icon" href="{{ asset('favicon.ico') }}">

		{% block jsonld %}
		<script type="application/ld+json">
		{"@context":"https://schema.org","@type":"Organization","name":"Youngbrighthing","url":"https://youngbrighthing.com","logo":"{{ absolute_url(asset('images/LOGO_ybt-01_72c34f78-1ef2-4c5c-a378-735dffc185cb.png')) }}","sameAs":["https://www.instagram.com/youngbrighthing/"],"contactPoint":{"@type":"ContactPoint","email":"contact@youngbrighthing.com","contactType":"customer service","availableLanguage":"French"}}
		</script>
		{% endblock %}

		<!-- Tailwind CSS via CDN -->
		<link
		href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">

		<!-- Fonts Google -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link
		href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Archivo:wght@400;500;600;700&display=swap" rel="stylesheet">

		<!-- Styles personnalisés supplémentaires -->
		<style>
		/* Palette de couleurs personnalisée */:root
		{
			--color-gold: #e8c547;
			--color-dark: #0d0c0b;
			--color-light: #f3f1ea;
			--color-gray: #151412;
		}

		/* Police personnalisée */
		body {
			font-family: 'Archivo', sans-serif;
		}

		h1,
		h2,
		h3,
		h4,
		h5,
		h6 {
			font-family: 'Bebas Neue', sans-serif;
			letter-spacing: 1px;
		}

		/* Couleurs personnalisées */
		.bg-yb-gold {
			background-color: var(--color-gold);
		}
		.bg-yb-dark {
			background-color: var(--color-dark);
		}
		.bg-yb-light {
			background-color: var(--color-light);
		}
		.bg-yb-gray {
			background-color: var(--color-gray);
		}

		.text-yb-gold {
			color: var(--color-gold);
		}
		.text-yb-dark {
			color: var(--color-dark);
		}
		.text-yb-light {
			color: var(--color-light);
		}
		.text-yb-gray {
			color: var(--color-gray);
		}

		.border-yb-gold {
			border-color: var(--color-gold);
		}
		.border-yb-dark {
			border-color: var(--color-dark);
		}

		/* Composants personnalisés */
		.btn-primary {
			background-color: var(--color-dark);
			color: var(--color-gold);
			padding: 0.5rem 1rem;
			border-radius: 0.375rem;
			transition: opacity 0.2s;
		}

		.btn-primary:hover {
			opacity: 0.9;
		}

		.btn-secondary {
			background-color: var(--color-gray);
			color: var(--color-dark);
			padding: 0.5rem 1rem;
			border-radius: 0.375rem;
			transition: opacity 0.2s;
		}

		.btn-secondary:hover {
			opacity: 0.9;
		}

		.ybt-nav-link {
			color: var(--color-light);
			font-size: 13px;
			letter-spacing: 1px;
			text-transform: uppercase;
			font-weight: 500;
			transition: color 0.2s;
		}
		.ybt-nav-link:hover {
			color: var(--color-gold);
		}

		.ybt-cart-pill {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			font-size: 13px;
			letter-spacing: 1px;
			text-transform: uppercase;
			border: 1px solid rgba(243, 241, 234, 0.3);
			color: var(--color-light);
			padding: 10px 18px;
			border-radius: 2px;
			transition: border-color 0.2s, color 0.2s;
		}
		.ybt-cart-pill:hover {
			border-color: var(--color-gold);
			color: var(--color-gold);
		}
	</style>

	{% block stylesheets %}{% endblock %}

	<!-- Alpine.js via CDN pour les interactions légères -->
	<script src="https://cdn.jsdelivr.net/npm/alpinejs@3.13.1/dist/cdn.min.js" defer></script>

	{% block javascripts %}{% endblock %}
</head>
<body class="flex flex-col min-h-screen bg-yb-dark text-yb-light">
	<header class="sticky top-0 z-20 border-b border-gray-800" style="background:rgba(13,12,11,0.88);backdrop-filter:blur(8px);">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="flex items-center justify-between h-20">
				<div class="flex items-center gap-4">
					<button class="lg:hidden p-2 text-yb-light hover:text-yb-gold focus:outline-none" x-data="{}" @click="document.getElementById('mobileMenu').classList.toggle('hidden')" aria-expanded="false">
						<svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
						</svg>
					</button>
					<a href="{{ path('home') }}" class="flex-shrink-0 flex items-center" style="font-family:'Bebas Neue',sans-serif;font-size:24px;letter-spacing:2px;color:var(--color-light);">
						YOUNGBRIGHTING
					</a>
				</div>

				<nav class="hidden lg:flex items-center gap-9">
					<a href="{{ path('app_collection_all') }}" class="ybt-nav-link">Collection</a>
					<a href="{{ path('home') }}#drops" class="ybt-nav-link">Drops</a>
					<a href="{{ path('app_histoire') }}" class="ybt-nav-link">Histoire</a>
					{% if app.user %}
						{% if 'ROLE_ADMIN' in app.user.roles %}
							<a href="{{ path('app_admin_dashboard') }}" class="ybt-nav-link">Administration</a>
						{% endif %}
						<a href="{{ path('app_account') }}" class="ybt-nav-link">Mon compte</a>
						<a href="{{ path('app_logout') }}" class="ybt-nav-link">Déconnexion</a>
					{% else %}
						<a href="{{ path('app_login') }}" class="ybt-nav-link">Compte</a>
					{% endif %}
				</nav>

				{% if app.user and app.user.carts|first %}
					<a href="{{ path('app_cart_show', {'id': app.user.carts|first.id}) }}" class="ybt-cart-pill">
						Panier (<span class="cart-counter">{{ app.user.carts|first.product|length }}</span>)
					</a>
				{% else %}
					<a href="{{ app.user ? path('app_collection_all') : path('app_login') }}" class="ybt-cart-pill">
						Panier (<span class="cart-counter">0</span>)
					</a>
				{% endif %}
			</div>
		</div>

		<!-- Menu mobile -->
		<div class="hidden lg:hidden border-t border-gray-800" id="mobileMenu">
			<div class="px-4 pt-3 pb-4 space-y-3">
				<a href="{{ path('app_collection_all') }}" class="block ybt-nav-link">Collection</a>
				<a href="{{ path('home') }}#drops" class="block ybt-nav-link">Drops</a>
				<a href="{{ path('app_histoire') }}" class="block ybt-nav-link">Histoire</a>
				<a href="{{ path('app_campagne') }}" class="block ybt-nav-link">Campagne</a>
				{% if app.user %}
					{% if 'ROLE_ADMIN' in app.user.roles %}
						<a href="{{ path('app_admin_dashboard') }}" class="block ybt-nav-link">Administration</a>
					{% endif %}
					<a href="{{ path('app_account') }}" class="block ybt-nav-link">Mon compte</a>
					<a href="{{ path('app_logout') }}" class="block ybt-nav-link">Déconnexion</a>
				{% else %}
					<a href="{{ path('app_login') }}" class="block ybt-nav-link">Compte</a>
				{% endif %}
			</div>
		</div>
	</header>

	<main class="flex-grow">
		{% for label, messages in app.flashes %}
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
				{% for message in messages %}
					<div class="rounded-md p-4 {% if label == 'success' %}bg-green-100 text-green-800{% elseif label == 'danger' or label == 'error' %}bg-red-100 text-red-800{% else %}bg-blue-100 text-blue-800{% endif %}" role="alert">
						<p class="text-sm font-medium">{{ message }}</p>
					</div>
				{% endfor %}
			</div>
		{% endfor %}

		{% block body %}{% endblock %}
	</main>

	<footer class="bg-yb-dark text-yb-light mt-12 border-t border-gray-800">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
			<div class="grid grid-cols-1 gap-10 md:grid-cols-4">
				<div class="md:col-span-1">
					<div style="font-family:'Bebas Neue',sans-serif;font-size:24px;letter-spacing:2px;" class="mb-3">YOUNGBRIGHTING</div>
					<p class="text-sm opacity-60 max-w-xs leading-relaxed">Mode unisexe fait main en France. Pièces uniques en séries limitées, sans compromis.</p>
					<a href="https://www.instagram.com/youngbrighthing/" target="_blank" class="inline-flex items-center gap-2 mt-4 text-sm hover:text-yb-gold transition">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewbox="0 0 24 24">
							<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
						</svg>
						Instagram
					</a>
				</div>

				<div>
					<div class="text-xs uppercase tracking-wider opacity-45 mb-4">Boutique</div>
					<div class="flex flex-col gap-2 text-sm">
						<a href="{{ path('app_collection_all') }}" class="hover:text-yb-gold transition">Collection</a>
						<a href="{{ path('home') }}#drops" class="hover:text-yb-gold transition">Drops</a>
					</div>
				</div>

				<div>
					<div class="text-xs uppercase tracking-wider opacity-45 mb-4">Marque</div>
					<div class="flex flex-col gap-2 text-sm">
						<a href="{{ path('app_histoire') }}" class="hover:text-yb-gold transition">Histoire</a>
						<a href="{{ path('app_campagne') }}" class="hover:text-yb-gold transition">Campagne</a>
						{% if app.user %}
							<a href="{{ path('app_account') }}" class="hover:text-yb-gold transition">Mon compte</a>
						{% else %}
							<a href="{{ path('app_login') }}" class="hover:text-yb-gold transition">Compte</a>
						{% endif %}
					</div>
				</div>

				<div>
					<div class="text-xs uppercase tracking-wider opacity-45 mb-4">Infos</div>
					<div class="flex flex-col gap-2 text-sm">
						<a href="{{ path('app_cgv_cgu') }}" class="hover:text-yb-gold transition">CGV / CGU</a>
						<a href="{{ path('app_cgv_confidentialite') }}" class="hover:text-yb-gold transition">Confidentialité</a>
						<a href="{{ path('app_cgv_mentions_legales') }}" class="hover:text-yb-gold transition">Mentions légales</a>
						<a href="{{ path('app_cgv_retour') }}" class="hover:text-yb-gold transition">Retours</a>
					</div>
				</div>
			</div>

			<div class="flex justify-between text-xs opacity-40 mt-12 pt-6 border-t border-gray-800">
				<span>&copy; {{ "now"|date("Y") }} Youngbrighthing</span>
				<span>Fait main en France</span>
			</div>
		</div>
	</footer>
</body></html>
