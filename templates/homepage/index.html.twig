{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block meta_description %}Youngbrighthing — mode unisexe fait main en France. Capsules limitées, pièces uniques aux influences urbaines et brutes. Découvrez les dernières collections.{% endblock %}

{% block jsonld %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"ClothingStore","name":"Youngbrighthing","url":"https://youngbrighthing.com","logo":"{{ absolute_url(asset('images/LOGO_ybt-01_72c34f78-1ef2-4c5c-a378-735dffc185cb.png')) }}","description":"Mode unisexe fait main en France. Capsules limitées, pièces uniques.","sameAs":["https://www.instagram.com/youngbrighthing/"],"contactPoint":{"@type":"ContactPoint","email":"contact@youngbrighthing.com","contactType":"customer service","availableLanguage":"French"}}
</script>
{% endblock %}

{% block body %}

	<!-- HERO -->
	<section class="relative" style="height:88vh;min-height:600px;">
		<div class="absolute inset-0 overflow-hidden">
			<img src="{{ asset('images/IMG_20240417_172439_073.jpg') }}" alt="Youngbrighthing lookbook" class="w-full h-full object-cover">
			<div class="absolute inset-0" style="background:linear-gradient(180deg,rgba(13,12,11,0.15) 0%,rgba(13,12,11,0.05) 40%,rgba(13,12,11,0.92) 100%);"></div>
		</div>
		<div class="relative h-full flex items-end px-6 sm:px-12 pb-16">
			<div class="w-full flex flex-col sm:flex-row justify-between items-start sm:items-end gap-10">
				<div>
					{% if heroDrop %}
						<div class="text-xs sm:text-sm tracking-widest uppercase text-yb-gold mb-4">{{ heroDrop.name }} — Disponible maintenant</div>
					{% endif %}
					<h1 class="leading-none" style="font-size:clamp(56px,9vw,140px);">STAY<br>YOUNG,<br>STAY BRIGHT.</h1>
				</div>
				<div class="flex flex-col gap-4 items-start max-w-xs">
					<p class="text-sm leading-relaxed opacity-75">Pièces uniques, faites main en France. Séries limitées, sans compromis.</p>
					<a href="{{ path('app_collection_all') }}" class="inline-flex items-center gap-2 bg-yb-gold text-yb-dark px-7 py-3 text-sm uppercase tracking-wider font-bold rounded-sm hover:bg-opacity-90 transition">
						Voir la collection
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- DROPS -->
	<section id="drops" class="px-6 sm:px-12 py-24">
		<div class="flex justify-between items-baseline mb-12">
			<h2 class="text-4xl">LES DROPS</h2>
			<a href="{{ path('app_collection_all') }}" class="ybt-nav-link">Tout voir →</a>
		</div>
		<div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
			{% for drop in drops %}
				{% set dropProduct = drop.products.first %}
				<a href="{{ path('app_drop', { name: drop.name }) }}" class="relative block rounded-sm overflow-hidden group" style="aspect-ratio:3/4;">
					{% if dropProduct %}
						<img src="{{ asset('images/product/' ~ dropProduct.imageName) }}" alt="{{ drop.name }}" class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-105 transition duration-300">
					{% else %}
						<div class="absolute inset-0 bg-yb-gray"></div>
					{% endif %}
					<div class="absolute inset-0" style="background:linear-gradient(180deg,transparent 55%,rgba(13,12,11,0.9) 100%);"></div>
					<div class="absolute bottom-0 left-0 p-6">
						<div class="text-xs tracking-widest uppercase text-yb-gold mb-1">Collection</div>
						<div class="text-2xl">{{ drop.name }}</div>
					</div>
				</a>
			{% else %}
				<p class="opacity-60 col-span-3">Aucune collection pour le moment.</p>
			{% endfor %}
		</div>
	</section>

	<!-- FEATURED PRODUCTS -->
	<section class="px-6 sm:px-12 pb-24">
		<h2 class="text-4xl mb-12">NOUVELLE ARRIVÉE</h2>
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-7">
			{% for product in featuredProducts %}
				<div>
					<div class="relative rounded-sm overflow-hidden mb-4" style="aspect-ratio:3/4;">
						<img src="{{ asset('images/product/' ~ product.imageName) }}" alt="{{ product.name }}" class="absolute inset-0 w-full h-full object-cover">
						{% if not product.isAvailable() %}
							<div class="absolute top-3 left-3 bg-yb-dark text-yb-light text-xs uppercase tracking-wider px-3 py-1.5 rounded-sm">Épuisé</div>
						{% endif %}
					</div>
					<div class="flex justify-between text-sm mb-1">
						<span class="font-semibold">{{ product.name }}</span>
						<span class="text-yb-gold">{{ product.price|number_format(2, ',', ' ') }} €</span>
					</div>
					<div class="text-xs opacity-55 tracking-wide mb-3">Taille {{ product.size }}</div>
					<div class="flex flex-col gap-2">
						<a href="{{ path('app_product', { id: product.id }) }}" class="block w-full py-2 text-center border border-gray-700 text-yb-light text-sm uppercase tracking-wider rounded-sm hover:border-yb-gold hover:text-yb-gold transition">
							Voir
						</a>
						{% if product.isAvailable() %}
							{% if is_granted('IS_AUTHENTICATED_FULLY') %}
								<button class="add-to-cart-btn block w-full py-2 text-center bg-yb-gold text-yb-dark text-sm uppercase tracking-wider font-bold rounded-sm hover:bg-opacity-90 transition" data-product-id="{{ product.id }}">
									Ajouter au panier
								</button>
							{% else %}
								<a href="{{ path('app_login') }}" class="block w-full py-2 text-center bg-yb-gold text-yb-dark text-sm uppercase tracking-wider font-bold rounded-sm hover:bg-opacity-90 transition">
									Se connecter
								</a>
							{% endif %}
						{% else %}
							<button disabled class="block w-full py-2 text-center bg-gray-800 text-gray-500 text-sm uppercase tracking-wider rounded-sm cursor-not-allowed">
								Épuisé
							</button>
						{% endif %}
					</div>
				</div>
			{% else %}
				<p class="opacity-60 col-span-4">Aucun produit pour le moment.</p>
			{% endfor %}
		</div>
	</section>

	<!-- HISTOIRE -->
	<section id="histoire" class="grid grid-cols-1 md:grid-cols-2" style="background:var(--color-gray);min-height:560px;">
		<div class="px-8 sm:px-16 py-20 flex flex-col justify-center">
			<div class="text-xs tracking-widest uppercase text-yb-gold mb-5">Notre histoire</div>
			<h2 class="text-4xl leading-tight mb-6 max-w-md">NÉE DANS LA RUE,<br>PORTÉE PARTOUT.</h2>
			<p class="text-sm leading-relaxed opacity-70 max-w-md mb-7">La mode de rue mérite mieux que la fast fashion. Chaque pièce Youngbrighthing est unique, faite main en France, produite en petite série.</p>
			<a href="{{ path('app_histoire') }}" class="text-sm uppercase tracking-wider border-b border-yb-gold pb-1 w-fit hover:text-yb-gold transition">Lire notre histoire</a>
		</div>
		<div class="relative min-h-[280px]">
			<img src="{{ asset('images/IMG_20240417_172439_073.jpg') }}" alt="Youngbrighthing" class="absolute inset-0 w-full h-full object-cover">
		</div>
	</section>
{% endblock %}
