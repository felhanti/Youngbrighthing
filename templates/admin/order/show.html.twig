{% extends 'base.html.twig' %}

{% block title %}Commande #{{ order.id }} - Administration{% endblock %}

{% block body %}
<div class="bg-gray-100 min-h-screen py-10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="md:flex md:items-center md:justify-between mb-6">
            <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl">
                Commande #{{ order.id }}
            </h2>
            <a href="{{ path('app_admin_order_index') }}" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                Retour à la liste
            </a>
        </div>

        <div class="bg-white shadow rounded-lg mb-6">
            <div class="px-4 py-5 sm:p-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
                <div>
                    <dt class="text-sm font-medium text-gray-500">Client</dt>
                    <dd class="mt-1 text-sm text-gray-900">
                        {% if order.user %}
                            {{ order.user.prenom }} {{ order.user.nom }}<br>
                            <span class="text-gray-500">{{ order.user.email }}</span><br>
                            <span class="text-gray-500">{{ order.user.adress }}, {{ order.user.cp }} {{ order.user.city }}</span>
                        {% else %}
                            Client supprimé
                        {% endif %}
                    </dd>
                </div>
                <div>
                    <dt class="text-sm font-medium text-gray-500">Date</dt>
                    <dd class="mt-1 text-sm text-gray-900">{{ order.createdAt|date('d/m/Y H:i') }}</dd>
                </div>
                <div>
                    <dt class="text-sm font-medium text-gray-500">Statut</dt>
                    <dd class="mt-1 text-sm text-gray-900">{{ include('order/_status_badge.html.twig') }}</dd>
                </div>
            </div>
        </div>

        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-4 rounded-md px-4 py-3 text-sm {{ type == 'success' ? 'bg-green-50 text-green-800' : 'bg-red-50 text-red-800' }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        {% if order.status == 'completed' %}
            <form method="post" action="{{ path('app_admin_order_ship', {id: order.id}) }}" class="bg-white shadow rounded-lg mb-6 px-4 py-5 sm:p-6 sm:flex sm:items-end sm:space-x-4">
                <input type="hidden" name="_token" value="{{ csrf_token('ship' ~ order.id) }}">
                <div class="flex-1">
                    <label for="tracking_number" class="block text-sm font-medium text-gray-700">Numéro de suivi (facultatif)</label>
                    <input type="text" id="tracking_number" name="tracking_number" maxlength="100" placeholder="Ex. 6A12345678901"
                           class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 text-sm focus:outline-none focus:ring-yb-gold focus:border-yb-gold">
                </div>
                <button type="submit" class="mt-3 sm:mt-0 inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-yb-dark hover:bg-opacity-90">
                    Marquer comme expédiée et prévenir le client
                </button>
            </form>
        {% elseif order.status == 'shipped' %}
            <div class="bg-white shadow rounded-lg mb-6 px-4 py-5 sm:p-6 text-sm text-gray-700">
                Expédiée le {{ order.shippedAt|date('d/m/Y à H:i') }}{% if order.trackingNumber %}, suivi <strong>{{ order.trackingNumber }}</strong>{% endif %}.
            </div>
        {% endif %}

        <div class="bg-white shadow rounded-lg overflow-hidden">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Pièce</th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Prix</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    {% for item in order.orderItems %}
                        <tr>
                            <td class="px-6 py-4 text-sm text-gray-900">{{ item.productName }}</td>
                            <td class="px-6 py-4 text-sm text-gray-900 text-right">{{ item.totalPrice|number_format(2, ',', ' ') }} €</td>
                        </tr>
                    {% endfor %}
                </tbody>
                <tfoot class="bg-gray-50">
                    <tr>
                        <td class="px-6 py-3 text-sm font-medium text-gray-900">Total</td>
                        <td class="px-6 py-3 text-sm font-bold text-gray-900 text-right">{{ order.total|number_format(2, ',', ' ') }} €</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
{% endblock %}
