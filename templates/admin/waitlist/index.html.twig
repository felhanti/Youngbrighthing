{% extends 'base.html.twig' %}

{% block title %}Liste d'attente - Administration{% endblock %}

{% block body %}
<div class="bg-gray-100 min-h-screen py-10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="md:flex md:items-center md:justify-between mb-6">
            <div>
                <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl">Liste d'attente</h2>
                <p class="mt-1 text-sm text-gray-500">{{ subscribers|length }} personne(s) à prévenir. L'envoi se fait depuis la fiche d'un drop.</p>
            </div>
            <div class="mt-4 flex gap-2 md:mt-0">
                <a href="{{ path('app_admin_waitlist_export') }}" class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-yb-dark hover:bg-opacity-90">Exporter en CSV</a>
                <a href="{{ path('app_admin_dashboard') }}" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">Tableau de bord</a>
            </div>
        </div>

        <div class="bg-white shadow rounded-lg overflow-hidden">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">E-mail</th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Inscription</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    {% for subscriber in subscribers %}
                        <tr>
                            <td class="px-6 py-3 text-sm text-gray-900">{{ subscriber.email }}</td>
                            <td class="px-6 py-3 text-sm text-gray-500 text-right">{{ subscriber.createdAt|date('d/m/Y') }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="2" class="px-6 py-8 text-center text-sm text-gray-500">Personne pour le moment. Le formulaire est en bas de chaque page du site.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
