{# Badge de statut de commande, partagé par le compte client et l'admin. #}
{% set colors = {
    pending: 'bg-gray-100 text-gray-800',
    processing: 'bg-yellow-100 text-yellow-800',
    completed: 'bg-blue-100 text-blue-800',
    shipped: 'bg-green-100 text-green-800',
    cancelled: 'bg-red-100 text-red-800',
} %}
<span class="{{ class|default('px-2 text-xs leading-5') }} inline-flex items-center font-semibold rounded-full {{ colors[order.status]|default('bg-gray-100 text-gray-800') }}">
    {{- order.statusLabel -}}
</span>
