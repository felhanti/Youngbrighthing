{% extends 'base.html.twig' %}

{% block title %}Liste d'attente{% endblock %}
{% block robots %}noindex, nofollow{% endblock %}

{% block body %}
<div class="max-w-lg mx-auto px-4 py-24 text-center">
	{% if done %}
		<h1 class="text-2xl font-bold mb-4">Vous n'êtes plus sur la liste d'attente</h1>
		<p class="opacity-70">Vous ne recevrez plus d'e-mail à la sortie des drops.</p>
	{% else %}
		<h1 class="text-2xl font-bold mb-4">Quitter la liste d'attente ?</h1>
		<p class="opacity-70 mb-8">{{ subscriber.email }} ne sera plus prévenu(e) de la sortie des prochains drops.</p>
		<form method="post">
			<button type="submit" class="px-6 py-3 bg-yb-gold text-yb-dark uppercase tracking-wider font-bold rounded-sm">Me désinscrire</button>
		</form>
	{% endif %}
	<a href="{{ path('home') }}" class="inline-block mt-8 text-sm underline opacity-70">Retour à la boutique</a>
</div>
{% endblock %}
