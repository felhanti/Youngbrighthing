<table style="width: 100%; border-collapse: collapse; margin: 24px 0;">
    {% for item in order.orderItems %}
        <tr>
            <td style="padding: 10px 0; border-bottom: 1px solid #E5E7EB; color: #1A1A1A;">{{ item.productName }}</td>
            <td style="padding: 10px 0; border-bottom: 1px solid #E5E7EB; text-align: right; color: #1A1A1A;">{{ item.totalPrice|number_format(2, ',', ' ') }} €</td>
        </tr>
    {% endfor %}
    <tr>
        <td style="padding: 12px 0; font-weight: bold; color: #1A1A1A;">Total</td>
        <td style="padding: 12px 0; font-weight: bold; text-align: right; color: #1A1A1A;">{{ order.total|number_format(2, ',', ' ') }} €</td>
    </tr>
</table>
